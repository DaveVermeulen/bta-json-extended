# Betafront test ramp: full-height at the north edge (z = 0), floor height at the south edge (z = 1).
# Bottom, back and slope are quads; the two sides are triangles.
mtllib test_obj_ramp.mtl
o Ramp
v 0 0 0
v 1 0 0
v 1 0 1
v 0 0 1
v 0 1 0
v 1 1 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 -1 0
vn 0 0 -1
vn 0 0.7071 0.7071
vn -1 0 0
vn 1 0 0
usemtl ramp
s off
# bottom
f 1/4/1 2/3/1 3/2/1 4/1/1
# back (north)
f 2/1/2 1/2/2 5/3/2 6/4/2
# slope
f 4/1/3 3/2/3 6/3/3 5/4/3
# west side
f 1/1/4 4/2/4 5/4/4
# east side
f 3/1/5 2/2/5 6/3/5
